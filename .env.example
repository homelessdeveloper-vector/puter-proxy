# ---------------------------------------------------------------------------
# Puter proxy — copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Server
NODE_ENV=development
PORT=8080
HOST=127.0.0.1
# Set to 1 when behind nginx/Caddy/Cloudflare so req.ip is the real client.
TRUST_PROXY=0

# --- Client auth -----------------------------------------------------------
# Comma-separated list of keys. Each entry:
#     name:secret            raw key, hashed in memory at boot
#     name:sha256:<hex>      pre-hashed key (preferred in production)
#     name:secret|scope+scope  append scopes; default is "execute" only
#
# Generate a key:      openssl rand -hex 32
# Hash it:             printf '%s' "$KEY" | shasum -a 256 | cut -d' ' -f1
#
# Scopes:
#   execute  call POST /v1/execute
#   admin    call /v1/accounts/*, pin a specific account, use "generic"
#
# Use "+" between scopes, not a comma (a comma starts a new key entry).
# A key without an explicit scope can never reach the admin endpoints.
#
# Copy the value below as-is to start in development, then replace it. Do not
# put a placeholder inside "sha256:" — a malformed digest is a boot error.
API_KEYS=local-dev:change-me-please-32-bytes-min,admin-dev:also-change-me|execute+admin

# --- Upstream credentials --------------------------------------------------
# Simplest case: one account.
PUTER_AUTH_TOKEN=

# Multiple accounts can be supplied three ways, and they compose (later
# sources override earlier ones by matching `id`):
#
#   1. ACCOUNTS_FILE      — local JSON manifest (default: ./accounts.json)
#   2. PUTER_ACCOUNTS     — inline JSON, useful for containers/secrets managers
#   3. ACCOUNT_MANIFEST_REPO — one or more GitHub repos, comma-separated:
#         owner/repo
#         owner/repo@main
#         owner/repo@main:config/accounts.json
#         https://github.com/owner/repo/blob/main/accounts.json
ACCOUNTS_FILE=./accounts.json
PUTER_ACCOUNTS=
ACCOUNT_MANIFEST_REPO=
# Token for private repos (fine-grained PAT, Contents: Read-only).
ACCOUNT_MANIFEST_TOKEN=

# Failover behaviour
# How many accounts to try for a single request before giving up.
ACCOUNT_MAX_ATTEMPTS=2
# Whether a 429 on one account spills over to the next. Off by default: it
# spreads rate-limit pressure across the whole pool.
ACCOUNT_FAILOVER_ON_429=0

# --- Egress -----------------------------------------------------------------
# Default outbound route for every account that doesn't declare its own proxy.
# Leave empty for direct connections.
#
#   PUTER_PROXY=tor                 -> socks5h://127.0.0.1:9050
#   PUTER_PROXY=9051                -> socks5h://127.0.0.1:9051
#   PUTER_PROXY=10.0.0.5:1080       -> socks5h://10.0.0.5:1080
#   PUTER_PROXY=http://proxy:3128   -> used as-is
#
# Requires a Tor daemon on 9050: `brew install tor && brew services start tor`
# (macOS) or `apt-get install tor && systemctl enable --now tor` (Debian).
# An individual account can override or opt out with "proxy": "..." / null.
PUTER_PROXY=

# --- Puter behaviour -------------------------------------------------------
# Override only for self-hosted Puter. Default: https://api.puter.com
PUTER_API_ORIGIN=
# Force OpenAI-style response bodies regardless of model release date.
PUTER_NORMALIZE=1
PUTER_DEFAULT_MODEL=gpt-5.1
PUTER_MAX_TOKENS_CAP=8192

# --- Limits ----------------------------------------------------------------
BODY_LIMIT=1mb
REQUEST_TIMEOUT_MS=120000
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# --- CORS ------------------------------------------------------------------
# Comma-separated exact origins. Empty = no browser access (server-to-server).
CORS_ORIGINS=

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=debug
