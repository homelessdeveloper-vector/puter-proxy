{
  "name": "puter-proxy",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted Express gateway that wraps Puter cloud capabilities behind a single authenticated JSON API.",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "accounts:add": "node scripts/add-account.js",
    "accounts:sync": "node scripts/sync-accounts.js",
    "accounts:check": "node scripts/check-accounts.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@heyputer/puter.js": "^2.6.4",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "socks": "^2.8.7",
    "undici": "^8.12.3"
  }
}
